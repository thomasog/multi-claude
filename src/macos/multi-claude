#!/bin/zsh
# multi-claude for macOS - run several Claude Desktop accounts side by side.
# https://github.com/thomasog/multi-claude
#
# A profile is the official Claude.app started with its own --user-data-dir, so it keeps its own
# sign-in. `add` builds ~/Applications/Claude <name>.app: a tiny launcher whose icon is Claude's own
# icon, recolored. No artwork ships with this tool.
set -euo pipefail

VERSION=0.1.7
HERE=${0:A:h}
CLAUDE_APP=${MULTI_CLAUDE_CLAUDE_APP:-/Applications/Claude.app}   # the override is for the tests
APPS=$HOME/Applications
BUNDLE_PREFIX=io.github.thomasog.multi-claude
NOT_FOUND="Claude Desktop was not found. Install it from https://claude.ai/download"
typeset -A PALETTE=(green 1F6F43 blue 1F4E8C purple 5B3A8E red 9B2C2C teal 146C6C pink A0346B gray 4A4F57)
COLORS=(green blue purple red teal pink gray)

USAGE="multi-claude $VERSION - several Claude Desktop accounts side by side

  multi-claude add <name> [--color <color>] [--claude-code <mode>]
                                              new profile, or change one: own sign-in and colored launcher
  multi-claude list                           installed profiles
  multi-claude open <name>                    open a profile
  multi-claude code <name> [claude arguments]  Claude Code in this terminal, on the profile's own folder
  multi-claude remove <name>                  remove a profile (its sign-in data is kept)
  multi-claude doctor [--selftest]            check this Mac
  multi-claude uninstall                      remove multi-claude and every profile launcher

Colors: ${(j:, :)COLORS} or a hex value like C0392B
Claude Code modes: own (new profiles: its own settings and sessions), synced (own, with skills,
agents, commands, output styles and CLAUDE.md from ~/.claude) or shared (~/.claude itself)"

fail()        { print -u2 -- "$1"; exit "${2:-1}"; }
data_dir()    { print -- "$HOME/Library/Application Support/Claude-$1"; }
launcher()    { print -- "$APPS/Claude $1.app"; }
re_escape()   { sed 's/[][\.*^$+?(){}|]/\\&/g' <<<"$1"; }   # a path as a literal in pgrep's regex
# -a: pgrep skips its own ancestors otherwise, and a terminal inside a profile descends from it.
is_running()  { pgrep -af -- "--user-data-dir=$(re_escape "$(data_dir "$1")")( |\$)" >/dev/null; }
# The profile's main process: Claude's helpers carry the same --user-data-dir.
main_pid()    { pgrep -af -- "^$(re_escape "$CLAUDE_APP")/Contents/MacOS/[^ ]+ (.* )?--user-data-dir=$(re_escape "$(data_dir "$1")")( |\$)" | head -n1; }
check_name() {
  [[ $1 =~ '^[A-Za-z0-9-]{1,24}$' ]] || fail "Profile name: letters, digits and dashes, up to 24 characters (e.g. Work)." 64
  [[ ${1:l} != 3p && ${1:l} != data ]] || fail "The name '$1' is reserved: Claude uses that folder itself." 64
  case ${1:u} in CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9]) fail "The name '$1' is reserved by Windows." 64 ;; esac
}
need_claude() { [[ -d $CLAUDE_APP ]] || fail "$NOT_FOUND"; }

# Claude Code: a profile with a .claude folder in its data folder runs its Code tab on it
# (CLAUDE_CONFIG_DIR); without one it shares ~/.claude, as every profile did before. The folder is
# the only record of the choice, so it survives `remove` and goes with the data folder.
SHARED=$HOME/.claude
SYNCED=(skills agents commands output-styles)
STUB='@~/.claude/CLAUDE.md'
code_dir()   { print -- "$(data_dir "$1")/.claude"; }
is_link()    { [[ -L $1/$2 && $(readlink "$1/$2") == "$SHARED/$2" ]]; }   # a link we made
is_stub()    { [[ -f $1/CLAUDE.md && ! -L $1/CLAUDE.md && $(<"$1/CLAUDE.md") == "$STUB" ]]; }
code_mode() {
  local dir n; dir=$(code_dir "$1")
  [[ -d $dir ]] || { print shared; return; }
  for n in $SYNCED; do if is_link "$dir" "$n"; then print synced; return; fi; done
  if is_stub "$dir"; then print synced; else print own; fi
}
# Settings that can carry a key or a token (an env block, a credential helper) are never copied.
# Only key names are matched, never values.
has_secrets() { grep -qE '"(env|apiKeyHelper|awsAuthRefresh|awsCredentialExport|otelHeadersHelper)"[[:space:]]*:' "$1"; }

# Fails before `add` changes anything if profile $1 can't move to mode $2 now.
check_code() {
  local now; now=$(code_mode "$1")
  [[ $2 == "$now" || ( $2 != shared && $now != shared ) ]] && return 0
  ! is_running "$1" || fail "Quit Claude $1 first: its Claude Code mode can't change while it runs."
  [[ $2 != shared || ! -e $(code_dir "$1").off ]] || fail "$(code_dir "$1").off already exists: move it aside first."
}

# This profile's Claude Code sessions, from Claude's own list of them. Ids name files, so only UUIDs.
session_ids() {
  local dir; dir="$(data_dir "$1")/claude-code-sessions"
  [[ -d $dir ]] || return 0
  find "$dir" -type f -name 'local_*.json' -exec sed -n 's/.*"cliSessionId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' {} + |
    grep -E '^[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$' | sort -u || true
}
# Copies $1 to $2 unless $2 is there already; an interrupted copy never stays half done.
copy_new() {
  [[ -e $1 && ! -e $2 ]] || return 1
  if ! { mkdir -p "${2:h}" && rm -rf "$2.partial" && cp -R "$1" "$2.partial" && mv "$2.partial" "$2"; }; then
    fail "Could not copy $1. Run add again to go on."
  fi
}
# Copies profile $1's sessions (transcript, its folder, file history) from ~/.claude into $2, which
# stays untouched. Prints how many transcripts it copied.
copy_sessions() {
  local id file rel count=0
  for id in ${(f)"$(session_ids "$1")"}; do
    for file in "$SHARED"/projects/*/"$id.jsonl"(N); do
      rel=${file#"$SHARED"/}
      if copy_new "$file" "$2/$rel"; then count=$((count + 1)); fi
      copy_new "${file%.jsonl}" "$2/${rel%.jsonl}" || true
    done
    copy_new "$SHARED/file-history/$id" "$2/file-history/$id" || true
  done
  print -- "$count"
}

# Puts profile $1 on Claude Code mode $2 and says what changed. check_code ran first.
set_code() {
  local name=$1 mode=$2 dir work n count list=""
  dir=$(code_dir "$name")
  if [[ $mode == shared ]]; then
    if [[ -d $dir ]]; then
      mv "$dir" "$dir.off"
      print -- "  Claude Code: shares ~/.claude again. Its own folder is kept as $dir.off; --claude-code own brings it back."
    else
      print -- "  Claude Code: shares ~/.claude with the regular Claude (--claude-code own gives it its own)."
    fi
    return
  fi
  if [[ ! -d $dir ]]; then
    # Filled aside and renamed last: a copy that stops halfway leaves the profile shared, and add goes on from there.
    if [[ -d $dir.off ]]; then work=$dir.off; else work=$dir.new; fi
    mkdir -p "$work"
    count=$(copy_sessions "$name" "$work")
    mv "$work" "$dir"
    rm -rf "$dir.new"   # only now: a copy an interrupted run left, when the parked folder came back
    if (( count )); then print -- "  Copied $count Claude Code session(s) of this profile from ~/.claude, which stays as it is."; fi
  fi
  if [[ $mode == own ]]; then
    for n in $SYNCED; do if is_link "$dir" "$n"; then rm "$dir/$n"; fi; done   # the link, not ~/.claude
    if is_stub "$dir"; then rm "$dir/CLAUDE.md"; fi
    print -- "  Claude Code: its own settings and sessions, in $dir."
    return
  fi
  # synced: what the profile has itself always wins; nothing is ever created in ~/.claude.
  if [[ ! -e $dir/settings.json && -f $SHARED/settings.json ]]; then
    if has_secrets "$SHARED/settings.json"; then
      print -- "  ~/.claude/settings.json was not copied: it has an env block or a credential helper. Copy what you need by hand."
    else
      cp "$SHARED/settings.json" "$dir/settings.json"
      print -- "  Copied ~/.claude/settings.json once; from now on this profile keeps its own."
    fi
  fi
  for n in $SYNCED; do
    if [[ -d $SHARED/$n && ! -e $dir/$n && ! -L $dir/$n ]]; then ln -s "$SHARED/$n" "$dir/$n"; fi
    if is_link "$dir" "$n"; then list+="$n, "; fi
  done
  if [[ -f $SHARED/CLAUDE.md && ! -e $dir/CLAUDE.md ]]; then print -r -- "$STUB" > "$dir/CLAUDE.md"; fi
  if is_stub "$dir"; then list+="CLAUDE.md, "; fi
  list=${list%, }
  # The folder is the setting: with no link made, list shows own. Say so rather than puzzle anyone.
  if [[ -z $list ]]; then print -- "  Claude Code: its own settings and sessions, in $dir; nothing to link from ~/.claude, so list shows it as own until there is. Run add $name --claude-code synced again then."; return; fi
  print -- "  Claude Code: its own settings and sessions, in $dir; from ~/.claude: $list."
}

# The mode `add` gives profile $1: the one asked for, or the one it has, or own for a new profile.
code_for() {
  case ${2:l} in
    own|synced|shared) print -- "${2:l}" ;;
    "") if [[ -d $(data_dir "$1") ]]; then code_mode "$1"; else print own; fi ;;
    *) fail "Unknown Claude Code mode '$2'. Use own, synced or shared." 64 ;;
  esac
}

# Sets a string key of an Info.plist; osacompile's applets don't always carry the key, so add it then.
plist_set() {
  /usr/libexec/PlistBuddy -c "Set :$2 \"$3\"" "$1" 2>/dev/null || /usr/libexec/PlistBuddy -c "Add :$2 string \"$3\"" "$1"
}

# Our launchers are told apart by their bundle ID, never by their name alone.
bundle_id() { /usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$1/Contents/Info.plist" 2>/dev/null; }
is_ours()   { local id; id=$(bundle_id "$1") && [[ $id == $BUNDLE_PREFIX.* ]]; }
# Launchers from 0.1.6 on stay open while their profile runs.
stays_open() { [[ $(/usr/libexec/PlistBuddy -c "Print :OSAAppletStayOpen" "$1/Contents/Info.plist" 2>/dev/null) == true ]]; }

profiles() {
  local app id
  for app in "$APPS"/Claude\ *.app(N); do
    id=$(bundle_id "$app") || continue
    if [[ $id == $BUNDLE_PREFIX.* ]]; then print -- "${id#$BUNDLE_PREFIX.}"; fi
  done
}

# An existing profile's spelling, so `open work` or `add work` acts on profile "Work".
canonical() {
  local n
  for n in ${(f)"$(profiles)"}; do
    if [[ ${n:l} == ${1:l} ]]; then print -- "$n"; return; fi
  done
  print -- "$1"
}

cmd_add() {
  local name=$1 color=$2 code hex
  check_name "$name"
  code=$(code_for "$name" "$3")
  hex=${color#\#}
  [[ -z $color ]] || hex=${PALETTE[${color:l}]:-$hex}   # no lookup with an empty key
  [[ $hex =~ '^[0-9A-Fa-f]{6}$' ]] || fail "Unknown color '$color'. Use ${(j:, :)COLORS} or a hex value like C0392B." 64
  if [[ -e $(launcher "$name") ]] && ! is_ours "$(launcher "$name")"; then
    fail "~/Applications/Claude $name.app exists and is not a multi-claude profile."
  fi
  # --claude-code alone on an existing profile changes only that: nothing records its color.
  if [[ -n $3 && $color_given == 0 ]] && is_ours "$(launcher "$name")"; then
    check_code "$name" "$code"; set_code "$name" "$code"; return
  fi
  need_claude
  check_code "$name" "$code"

  local work; work=$(mktemp -d)
  trap "rm -rf '$work'" EXIT

  # Icon: Claude's installed icon -> PNG -> recolored -> .icns
  local icon_file source s
  icon_file=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIconFile" "$CLAUDE_APP/Contents/Info.plist" 2>/dev/null) || icon_file=electron
  source="$CLAUDE_APP/Contents/Resources/${icon_file%.icns}.icns"
  [[ -f $source ]] || source=(${CLAUDE_APP}/Contents/Resources/*.icns(N[1]))
  [[ -f $source ]] || fail "Could not find Claude's icon in $CLAUDE_APP."
  sips -s format png -z 1024 1024 "$source" --out "$work/source.png" >/dev/null
  osascript -l JavaScript "$HERE/recolor.js" "$work/source.png" "$work/icon.png" "$hex"
  mkdir "$work/icon.iconset"
  for s in 16 32 128 256 512; do
    sips -z $s $s "$work/icon.png" --out "$work/icon.iconset/icon_${s}x${s}.png" >/dev/null
    sips -z $((s * 2)) $((s * 2)) "$work/icon.png" --out "$work/icon.iconset/icon_${s}x${s}@2x.png" >/dev/null
  done
  iconutil -c icns "$work/icon.iconset" -o "$work/icon.icns"

  # Launcher: runs `multi-claude open <name>` and stays open while the profile runs, so the Dock shows
  # its colored icon as running; the running Claude itself always has Claude's icon. Built aside, then
  # swapped in, so a failure keeps the old one.
  local app built plist script=${HERE//\\/\\\\}/multi-claude cli
  script=${script//\"/\\\"}                                     # escaped for an AppleScript string
  cli="quoted form of \"$script\""
  app=$(launcher "$name"); built="$work/Claude $name.app"; plist="$built/Contents/Info.plist"
  osacompile -s -o "$built" \
    -e "property seen : false" -e "property waited : 0" \
    -e "on openProfile()" -e "set seen to false" -e "set waited to 0" \
    -e "do shell script \"MULTI_CLAUDE_LAUNCHER=1 \" & $cli & \" open \" & quoted form of \"$name\"" \
    -e "end openProfile" \
    -e "on run" -e "openProfile()" -e "end run" \
    -e "on reopen" -e "openProfile()" -e "end reopen" \
    -e "on idle" -e "try" \
    -e "do shell script $cli & \" _running \" & quoted form of \"$name\"" -e "set seen to true" \
    -e "on error" -e "set waited to waited + 3" -e "if seen or waited > 60 then quit" \
    -e "end try" -e "return 3" -e "end idle"
  cp "$work/icon.icns" "$built/Contents/Resources/applet.icns"
  /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$plist" 2>/dev/null || true   # it would override applet.icns
  rm -f "$built/Contents/Resources/Assets.car"
  plist_set "$plist" CFBundleIdentifier "$BUNDLE_PREFIX.$name"
  plist_set "$plist" CFBundleName "Claude $name"
  codesign --force -s - "$built" >/dev/null 2>&1 || true   # resources changed: re-sign ad hoc, locally
  # The old launcher stays until the new one is complete beside it; then two renames swap them. A
  # running profile's launcher keeps running from the old copy until it quits, as before.
  local new="$APPS/.Claude $name.new" old="$APPS/.Claude $name.old"
  mkdir -p "$APPS"; rm -rf "$new" "$old"
  mv "$built" "$new"
  if [[ -e $app ]]; then mv "$app" "$old"; fi
  mv "$new" "$app"
  rm -rf "$old"
  touch "$app"

  print "
  Claude $name is ready: $app
  Drag it to the Dock. To sign in by e-mail, open the link in your browser, do not let it open
  Claude, and ask for a code to type in the profile. With single sign-on, quit every other Claude
  first (Cmd+Q), including other profiles: the browser hands the login to whichever Claude is open."
  set_code "$name" "$code"
}

cmd_list() {
  local -a names; names=(${(f)"$(profiles)"})
  (( $#names )) || { print "No profiles yet. Add one with: multi-claude add <name>"; return 0; }
  local n state
  for n in $names; do
    state=""; if is_running "$n"; then state=running; fi
    printf '%-16s %-8s %-7s %s\n' "$n" "$state" "$(code_mode "$n")" "$(data_dir "$n")"
  done
}

# By PID, because `open -a` would pick any Claude, the regular one included. Like a click on its Dock
# icon: activate, then a reopen event ('aevt' 'rapp'), which brings back a window that was closed.
bring_forward() {
  osascript -l JavaScript -e "ObjC.import('AppKit'); var app = \$.NSRunningApplication.runningApplicationWithProcessIdentifier($1); app.unhide; app.activateWithOptions(\$.NSApplicationActivateAllWindows); \$.NSAppleEventDescriptor.appleEventWithEventClassEventIDTargetDescriptorReturnIDTransactionID(0x61657674, 0x72617070, \$.NSAppleEventDescriptor.descriptorWithProcessIdentifier($1), -1, 0).sendEventWithOptionsTimeoutError(1, 5, null)" >/dev/null 2>&1 || true   # it may be quitting
}

# Claude Code in this terminal on the profile's own folder: everything after the name goes to claude
# untouched, and exec makes its exit code ours. Sign-ins are claude's own business, here as elsewhere.
cmd_code() {
  local dir
  is_ours "$(launcher "$1")" || fail "No profile named '$1'."
  command -v claude >/dev/null || fail "Claude Code's claude command is not on the PATH. Install Claude Code, or add its folder to the PATH."
  dir=$(code_dir "$1")
  # Started from inside a Claude session, we would hand its CLAUDE_*/ANTHROPIC_* variables to claude.
  # This also drops our own CLAUDE_APP, which nothing needs from here on.
  unset -m 'CLAUDE*' 'ANTHROPIC*'
  if [[ -d $dir ]]; then export CLAUDE_CONFIG_DIR=$dir
  else print -u2 -- "Claude $1 shares ~/.claude, so this Claude Code does too."; fi
  exec claude "${rest[@]}"
}

cmd_open() {
  check_name "$1"
  is_ours "$(launcher "$1")" || fail "No profile named '$1'."
  need_claude
  # Through the launcher, which calls back here, so its icon shows in the Dock as running. An older
  # launcher quits at once and calls back without the flag: it opens Claude here, as it always did.
  if [[ -z ${MULTI_CLAUDE_LAUNCHER:-} ]] && stays_open "$(launcher "$1")"; then open "$(launcher "$1")"; return; fi
  # Claude has no single-instance lock here: a second `open -n` would run it twice on the same data.
  local pid; if pid=$(main_pid "$1"); then bring_forward "$pid"; return 0; fi
  # Started from inside a Claude session, we would hand its CLAUDE_*/ANTHROPIC_* variables to Claude.
  # The profile's own Claude Code folder goes in by name, so the strip can't touch it.
  local -a launch=(open -n)
  if [[ -d $(code_dir "$1") ]]; then launch+=(--env "CLAUDE_CONFIG_DIR=$(code_dir "$1")"); fi
  launch+=(-a "$CLAUDE_APP" --args --user-data-dir="$(data_dir "$1")")
  ( unset -m 'CLAUDE*' 'ANTHROPIC*' MULTI_CLAUDE_LAUNCHER; "${launch[@]}" )
}

cmd_remove() {
  check_name "$1"
  is_ours "$(launcher "$1")" || fail "No profile named '$1'."
  rm -rf "$(launcher "$1")"
  print "Removed Claude $1. Remove its icon from the Dock if you kept it there."
  print "Its sign-in data is kept in $(data_dir "$1") - delete that folder to sign out for good."
}

cmd_doctor() {
  local tool
  print "multi-claude $VERSION"
  if [[ -d $CLAUDE_APP ]]; then
    print "Claude Desktop:   $(defaults read "$CLAUDE_APP/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null)"
  else
    print "Claude Desktop:   not found - https://claude.ai/download"
  fi
  for tool in sips iconutil osacompile osascript codesign; do
    if command -v $tool >/dev/null; then print "  $tool: ok"; else print "  $tool: missing"; fi
  done
  if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then print -- "CLAUDE_CONFIG_DIR: $CLAUDE_CONFIG_DIR in this terminal; open drops it: each profile uses its own folder or ~/.claude"; fi
  print
  cmd_list
}

cmd_uninstall() {
  local app link=$HOME/.local/bin/multi-claude
  for app in "$APPS"/Claude\ *.app(N); do
    if is_ours "$app"; then rm -rf "$app"; fi
  done
  rm -rf "$APPS"/.Claude\ *.new(N) "$APPS"/.Claude\ *.old(N)   # left by an interrupted add
  rm -rf "${XDG_DATA_HOME:-$HOME/.local/share}/multi-claude"
  # Only our own link: a real file there is someone else's install.
  if [[ -L $link && $(readlink "$link") == "${XDG_DATA_HOME:-$HOME/.local/share}/multi-claude/"* ]]; then rm -f "$link"; fi
  print "multi-claude removed. Sign-in data is kept in ~/Library/Application Support/Claude-* - delete those folders to sign out for good."
}

# --- arguments ---------------------------------------------------------------------------------------
cmd="" name="" color=green color_given=0 code="" selftest=0 rest=()
while (( $# )); do
  # `code <name>` hands everything after the name to claude, options included.
  if [[ ${cmd:l} == code && -n $name ]]; then rest=("$@"); break; fi
  case $1 in
    -c|--color)   (( $# >= 2 )) || fail "--color needs a value." 64; color=$2; color_given=1; shift ;;
    --claude-code) (( $# >= 2 )) || fail "--claude-code needs a value." 64; code=$2; shift ;;
    -h|--help)    cmd=help ;;
    -v|--version) cmd=version ;;
    --selftest)   selftest=1 ;;
    -*)           fail "Unknown option '$1'."$'\n\n'"$USAGE" 64 ;;
    *)
      if [[ -z $cmd ]]; then cmd=$1
      elif [[ -z $name ]]; then name=$1
      else fail "Unexpected argument '$1'."$'\n\n'"$USAGE" 64; fi ;;
  esac
  shift
done

case ${cmd:l} in
  add)       check_name "$name"; cmd_add "$(canonical "$name")" "$color" "$code" ;;
  list)      cmd_list ;;
  open)      check_name "$name"; cmd_open "$(canonical "$name")" ;;
  remove)    check_name "$name"; cmd_remove "$(canonical "$name")" ;;
  code)      check_name "$name"; cmd_code "$(canonical "$name")" ;;
  doctor)    cmd_doctor; if (( selftest )); then print; print "Self-test: Windows only (taskbar tagging)."; fi ;;
  uninstall) cmd_uninstall ;;
  _running)  check_name "$name"; name=$(canonical "$name")             # internal: the launcher's check
             is_ours "$(launcher "$name")" && is_running "$name" ;;      # a removed profile's launcher quits
  version)   print "multi-claude $VERSION" ;;
  _claude-code) check_name "$name"; c=$(code_for "$name" "$code"); check_code "$name" "$c"; set_code "$name" "$c" ;;   # internal: add's last step, for the tests
  help|"")   print -- "$USAGE" ;;
  *)         fail "Unknown command '$cmd'."$'\n\n'"$USAGE" 64 ;;
esac
