#!/usr/bin/env bash
# multi-claude for Linux (experimental) - run several Claude Desktop accounts side by side.
# https://github.com/thomasog/multi-claude
#
# A profile is the official Claude Desktop started with its own --user-data-dir, so it keeps its own
# sign-in. `add` creates a desktop entry whose icon is Claude's own icon, recolored. No artwork ships
# with this tool.
set -euo pipefail

VERSION=0.1.4
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
DATA=${XDG_DATA_HOME:-$HOME/.local/share}
ENTRIES=$DATA/applications
PROFILES=$DATA/multi-claude/profiles
NOT_FOUND="Claude Desktop was not found. Install it from https://claude.ai/download"
declare -A PALETTE=([green]=1F6F43 [blue]=1F4E8C [purple]=5B3A8E [red]=9B2C2C [teal]=146C6C [pink]=A0346B [gray]=4A4F57)
COLORS="green, blue, purple, red, teal, pink, gray"

USAGE="multi-claude $VERSION - several Claude Desktop accounts side by side (Linux: experimental)

  multi-claude add <name> [--color <color>]   new profile: own sign-in and colored launcher
  multi-claude list                           installed profiles
  multi-claude open <name>                    open a profile
  multi-claude remove <name>                  remove a profile (its sign-in data is kept)
  multi-claude doctor [--selftest]            check this machine
  multi-claude uninstall                      remove multi-claude and every profile launcher

Colors: $COLORS or a hex value like C0392B"

fail()       { echo "$1" >&2; exit "${2:-1}"; }
data_dir()   { echo "$CONFIG/Claude-$1"; }
app_id()     { echo "multi-claude-${1,,}"; }   # desktop file id = window class, so docks group them
entry_of()   { echo "$ENTRIES/$(app_id "$1").desktop"; }
is_running() { command -v pgrep >/dev/null && pgrep -f -- "--user-data-dir=$(data_dir "$1")( |\$)" >/dev/null; }
check_name() {
  [[ $1 =~ ^[A-Za-z0-9-]{1,24}$ ]] || fail "Profile name: letters, digits and dashes, up to 24 characters (e.g. Work)." 64
  [[ ${1,,} != 3p && ${1,,} != data ]] || fail "The name '$1' is reserved: Claude uses that folder itself." 64
  case ${1^^} in CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9]) fail "The name '$1' is reserved by Windows." 64 ;; esac
}
entry_key()  { grep -m1 "^$2=" "$1" | cut -d= -f2-; }

# Claude in Chrome: each browser keeps one manifest naming the Claude it talks to, and every Claude
# instance writes its own data folder into it. Keep it on the regular Claude.
BROWSERS=(Chrome:google-chrome Edge:microsoft-edge Brave:BraveSoftware/Brave-Browser Chromium:chromium)
PROFILE_HOST='/Claude-([^/]+)/ChromeNativeHost/'
manifest_of() { echo "$CONFIG/${1#*:}/NativeMessagingHosts/com.anthropic.claude_browser_extension.json"; }
host_path()   { sed -n 's/.*"path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" | head -n1; }
main_path()   { sed -E "s#$PROFILE_HOST#/Claude/ChromeNativeHost/#g"; }

# The profile holding a host path, if any ("Claude-3p" and "Claude-Data" are Claude's own folders).
held_by() { [[ $1 =~ $PROFILE_HOST && ${BASH_REMATCH[1],,} != 3p && ${BASH_REMATCH[1],,} != data ]] && echo "${BASH_REMATCH[1]}"; }

repair_pairing() {
  local browser manifest main tmp
  for browser in "${BROWSERS[@]}"; do
    manifest=$(manifest_of "$browser")
    [[ -f $manifest ]] || continue
    held_by "$(host_path "$manifest")" >/dev/null || continue
    main=$(host_path "$manifest" | main_path)
    [[ -e $main ]] || continue                 # the regular Claude has no host to point back to
    tmp=$(mktemp "$manifest.XXXXXX") && main_path < "$manifest" > "$tmp" && mv "$tmp" "$manifest"
  done
}

pairing() {
  local browser manifest holder out=""
  for browser in "${BROWSERS[@]}"; do
    manifest=$(manifest_of "$browser")
    [[ -f $manifest ]] || continue
    if holder=$(held_by "$(host_path "$manifest")"); then
      out+="${browser%%:*}: profile $holder, "
    else
      out+="${browser%%:*}: regular Claude, "
    fi
  done
  if [[ -n $out ]]; then echo "${out%, }"; else echo "not set up"; fi
}

# Started by `open` in the background: keeps the pairing on the regular Claude while the profile
# runs, then exits. One per profile: a lock folder holds the watcher's pid.
GUARD_LOCK=""
is_guard() {
  local args
  [[ -n $1 ]] || return 1
  if args=$(ps -p "$1" -o args= 2>/dev/null); then [[ $args == *" _guard "* ]]; else kill -0 "$1" 2>/dev/null; fi
}
cmd_guard() {
  local name=$1 waited=0 owner
  GUARD_LOCK=${TMPDIR:-/tmp}/multi-claude-$(id -u)-$name.lock
  if ! mkdir "$GUARD_LOCK" 2>/dev/null; then
    sleep 1                                   # let a watcher that just took the lock write its pid
    owner=$(cat "$GUARD_LOCK/pid" 2>/dev/null || true)
    if is_guard "$owner"; then return 0; fi
    # No pid yet: busy, unless the lock is a minute old (its watcher died before writing it).
    if [[ -z $owner && -z $(find "$GUARD_LOCK" -maxdepth 0 -mmin +1 2>/dev/null) ]]; then return 0; fi
    rm -rf "$GUARD_LOCK"; mkdir "$GUARD_LOCK" 2>/dev/null || return 0
  fi
  echo $$ > "$GUARD_LOCK/pid.tmp" && mv "$GUARD_LOCK/pid.tmp" "$GUARD_LOCK/pid"
  trap 'rm -rf "$GUARD_LOCK"' EXIT
  if command -v pgrep >/dev/null; then
    while ! is_running "$name" && (( waited++ < 60 )); do sleep 1; done
    while is_running "$name"; do repair_pairing; sleep 3; done
  else
    for _ in $(seq 40); do repair_pairing; sleep 3; done
  fi
  repair_pairing
}

# An existing profile's spelling, so `open work` finds profile "Work".
canonical() {
  local name
  if [[ -f $(entry_of "$1") ]]; then name=$(entry_key "$(entry_of "$1")" Name); echo "${name#Claude }"; else echo "$1"; fi
}

# Where desktop entries and icons live: the user's folder, then the system ones (Flatpak and Snap
# add their exports to XDG_DATA_DIRS).
data_dirs() {
  local dir; local -a dirs
  IFS=: read -ra dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for dir in "$DATA" "${dirs[@]}"; do [[ -z $dir ]] || echo "$dir"; done
}

# The official desktop entry says how Claude is launched and which icon it uses.
claude_entry() {
  local dir file; local -a dirs
  mapfile -t dirs < <(data_dirs)
  for dir in "${dirs[@]}"; do
    for file in "$dir"/applications/*.desktop; do
      [[ -f $file && $(basename "$file") != multi-claude-* ]] || continue
      if grep -qE '^Name=Claude( Desktop)?$' "$file"; then echo "$file"; return 0; fi
    done
  done
  return 1
}

claude_launch() { entry_key "$1" Exec | sed -E 's/ ?%[fFuUdDnNickvm]//g'; }   # drop field codes

claude_icon() {
  local icon size dir; local -a dirs
  icon=$(entry_key "$1" Icon)
  if [[ $icon == /* && -f $icon ]]; then echo "$icon"; return 0; fi
  mapfile -t dirs < <(data_dirs)
  for size in 512x512 256x256 128x128; do
    for dir in "${dirs[@]}"; do
      if [[ -f $dir/icons/hicolor/$size/apps/$icon.png ]]; then echo "$dir/icons/hicolor/$size/apps/$icon.png"; return 0; fi
    done
  done
  if [[ -f /usr/share/pixmaps/$icon.png ]]; then echo "/usr/share/pixmaps/$icon.png"; return 0; fi
  return 1
}

cmd_add() {
  local name=$1 color=$2 hex entry icon dir existing colored
  check_name "$name"
  hex=${color#\#}
  [[ -z $color ]] || hex=${PALETTE[${color,,}]:-$hex}   # an empty key is a bash error
  [[ $hex =~ ^[0-9A-Fa-f]{6}$ ]] || fail "Unknown color '$color'. Use $COLORS or a hex value like C0392B." 64
  if [[ -f $(entry_of "$name") ]]; then
    existing=$(entry_key "$(entry_of "$name")" Name); existing=${existing#Claude }
    [[ $existing == "$name" ]] || fail "A profile named '$existing' already exists; names are not case-sensitive." 64
  fi
  entry=$(claude_entry) || fail "$NOT_FOUND"
  icon=$(claude_icon "$entry") || fail "Could not find Claude's icon ($(entry_key "$entry" Icon))."
  command -v python3 >/dev/null || fail "python3 is required to color the icon."

  # The profile folder appears only once the icon is colored, so a failure leaves nothing behind.
  dir=$PROFILES/$name
  mkdir -p "$PROFILES" "$ENTRIES"
  colored=$(mktemp "$PROFILES/.icon.XXXXXX")
  python3 "$HERE/recolor.py" "$icon" "$colored" "$hex" || { rm -f "$colored"; exit 1; }
  chmod 644 "$colored"
  mkdir -p "$dir" && mv -f "$colored" "$dir/icon.png"
  cat > "$(entry_of "$name")" <<EOF
[Desktop Entry]
Type=Application
Name=Claude $name
Comment=Claude Desktop - $name
Exec="$HERE/multi-claude" open $name
Icon=$dir/icon.png
StartupWMClass=$(app_id "$name")
Categories=Office;Utility;
Terminal=false
EOF
  if command -v update-desktop-database >/dev/null; then update-desktop-database "$ENTRIES" 2>/dev/null || true; fi

  echo "
  Claude $name is ready: find it in your app launcher and pin it to your dock.
  To sign in, choose \"Sign in with a code\". With single sign-on, quit every other Claude first,
  including other profiles: the browser hands the login to whichever Claude is open."
}

cmd_list() {
  local file name found=0
  for file in "$ENTRIES"/multi-claude-*.desktop; do
    [[ -f $file ]] || continue
    found=1; name=$(entry_key "$file" Name); name=${name#Claude }
    printf '%-16s %-8s %s\n' "$name" "$(if is_running "$name"; then echo running; fi)" "$(data_dir "$name")"
  done
  if (( ! found )); then echo "No profiles yet. Add one with: multi-claude add <name>"; fi
}

cmd_open() {
  local entry var; local -a argv
  check_name "$1"
  [[ -f $(entry_of "$1") ]] || fail "No profile named '$1'."
  entry=$(claude_entry) || fail "$NOT_FOUND"
  # Started from inside a Claude session, we would hand its CLAUDE_*/ANTHROPIC_* variables to Claude.
  for var in $(compgen -e); do
    if [[ $var =~ ^(CLAUDE|ANTHROPIC) ]]; then unset "$var"; fi
  done
  # Split Exec like a desktop launcher would, so quoted paths ("/opt/Claude Desktop/claude") survive.
  mapfile -t argv < <(xargs -n1 printf '%s\n' <<<"$(claude_launch "$entry")")
  command -v "${argv[0]}" >/dev/null || fail "Cannot run Claude: ${argv[0]}"
  repair_pairing
  nohup "${argv[@]}" "--user-data-dir=$(data_dir "$1")" "--class=$(app_id "$1")" >/dev/null 2>&1 &
  nohup "$HERE/multi-claude" _guard "$1" >/dev/null 2>&1 &
}

cmd_remove() {
  check_name "$1"
  [[ -f $(entry_of "$1") ]] || fail "No profile named '$1'."
  rm -f "$(entry_of "$1")"
  rm -rf "${PROFILES:?}/$1"
  repair_pairing
  echo "Removed Claude $1. Its sign-in data is kept in $(data_dir "$1") - delete that folder to sign out for good."
}

cmd_doctor() {
  local entry
  echo "multi-claude $VERSION (Linux support is experimental)"
  if entry=$(claude_entry); then
    echo "Claude Desktop:   $entry"
    echo "  launch: $(claude_launch "$entry")"
    echo "  icon:   $(claude_icon "$entry" || echo 'not found')"
  else
    echo "Claude Desktop:   not found - https://claude.ai/download"
  fi
  if command -v python3 >/dev/null; then echo "  python3: ok"; else echo "  python3: missing"; fi
  echo "Browser pairing:  $(pairing)"
  echo
  cmd_list
}

cmd_uninstall() {
  local link=$HOME/.local/bin/multi-claude
  # Only our own link: a real file there is someone else's install.
  if [[ -L $link && $(readlink "$link") == "$DATA/multi-claude/"* ]]; then rm -f "$link"; fi
  rm -f "$ENTRIES"/multi-claude-*.desktop
  rm -rf "${DATA:?}/multi-claude"
  repair_pairing
  echo "multi-claude removed. Sign-in data is kept in $CONFIG/Claude-* - delete those folders to sign out for good."
}

# --- arguments ---------------------------------------------------------------------------------------
cmd="" name="" color=green selftest=0
while (( $# )); do
  case $1 in
    -c|--color)   (( $# >= 2 )) || fail "--color needs a value." 64; color=$2; shift ;;
    -h|--help)    cmd=help ;;
    -v|--version) cmd=version ;;
    --selftest)   selftest=1 ;;
    -*)           fail "Unknown option '$1'."$'\n\n'"$USAGE" 64 ;;
    *)
      if [[ -z $cmd ]]; then cmd=$1
      elif [[ -z $name ]]; then name=$1
      else fail "Unexpected argument '$1'."$'\n\n'"$USAGE" 64; fi ;;
  esac
  shift
done

case ${cmd,,} in
  add)       cmd_add "$name" "$color" ;;
  list)      cmd_list ;;
  open)      check_name "$name"; cmd_open "$(canonical "$name")" ;;
  remove)    check_name "$name"; cmd_remove "$(canonical "$name")" ;;
  doctor)    cmd_doctor; if (( selftest )); then echo; echo "Self-test: Windows only (taskbar tagging)."; fi ;;
  uninstall) cmd_uninstall ;;
  version)   echo "multi-claude $VERSION" ;;
  _guard)    check_name "$name"; cmd_guard "$name" ;;   # internal: started by `open`
  _repair-pairing) repair_pairing ;;                   # internal: used by the tests
  help|"")   echo "$USAGE" ;;
  *)         fail "Unknown command '$cmd'."$'\n\n'"$USAGE" 64 ;;
esac
