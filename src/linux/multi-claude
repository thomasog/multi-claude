#!/usr/bin/env bash
# multi-claude for Linux (experimental) - run several Claude Desktop accounts side by side.
# https://github.com/thomasog/multi-claude
#
# A profile is the official Claude Desktop started with its own --user-data-dir, so it keeps its own
# sign-in. `add` creates a desktop entry whose icon is Claude's own icon, recolored. No artwork ships
# with this tool.
set -euo pipefail

VERSION=0.1.6
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
DATA=${XDG_DATA_HOME:-$HOME/.local/share}
ENTRIES=$DATA/applications
PROFILES=$DATA/multi-claude/profiles
NOT_FOUND="Claude Desktop was not found. Install it from https://claude.ai/download"
declare -A PALETTE=([green]=1F6F43 [blue]=1F4E8C [purple]=5B3A8E [red]=9B2C2C [teal]=146C6C [pink]=A0346B [gray]=4A4F57)
COLORS="green, blue, purple, red, teal, pink, gray"

USAGE="multi-claude $VERSION - several Claude Desktop accounts side by side (Linux: experimental)

  multi-claude add <name> [--color <color>] [--claude-code <mode>]
                                              new profile, or change one: own sign-in and colored launcher
  multi-claude list                           installed profiles
  multi-claude open <name>                    open a profile
  multi-claude remove <name>                  remove a profile (its sign-in data is kept)
  multi-claude doctor [--selftest]            check this machine
  multi-claude uninstall                      remove multi-claude and every profile launcher

Colors: $COLORS or a hex value like C0392B
Claude Code modes: own (new profiles: its own settings and sessions), synced (own, with skills,
agents, commands, output styles and CLAUDE.md from ~/.claude) or shared (~/.claude itself)"

fail()       { echo "$1" >&2; exit "${2:-1}"; }
data_dir()   { echo "$CONFIG/Claude-$1"; }
app_id()     { echo "multi-claude-${1,,}"; }   # desktop file id = window class, so docks group them
entry_of()   { echo "$ENTRIES/$(app_id "$1").desktop"; }
# A path as a literal in pgrep's regex. sed, since ${1//...} takes & as the match only from bash 5.2.
# shellcheck disable=SC2001
re_escape()  { sed 's/[][\.*^$+?(){}|]/\\&/g' <<<"$1"; }
is_running() { command -v pgrep >/dev/null && pgrep -f -- "--user-data-dir=$(re_escape "$(data_dir "$1")")( |\$)" >/dev/null; }
check_name() {
  [[ $1 =~ ^[A-Za-z0-9-]{1,24}$ ]] || fail "Profile name: letters, digits and dashes, up to 24 characters (e.g. Work)." 64
  [[ ${1,,} != 3p && ${1,,} != data ]] || fail "The name '$1' is reserved: Claude uses that folder itself." 64
  case ${1^^} in CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9]) fail "The name '$1' is reserved by Windows." 64 ;; esac
}
entry_key()  { grep -m1 "^$2=" "$1" | cut -d= -f2-; }

# Claude Code: a profile with a .claude folder in its data folder runs its Code tab on it
# (CLAUDE_CONFIG_DIR); without one it shares ~/.claude, as every profile did before. The folder is
# the only record of the choice, so it survives `remove` and goes with the data folder.
SHARED=$HOME/.claude
SYNCED=(skills agents commands output-styles)
STUB='@~/.claude/CLAUDE.md'
code_dir()   { echo "$(data_dir "$1")/.claude"; }
is_ours()    { [[ -L $1/$2 && $(readlink "$1/$2") == "$SHARED/$2" ]]; }   # a link we made
is_stub()    { [[ -f $1/CLAUDE.md && ! -L $1/CLAUDE.md && $(cat "$1/CLAUDE.md") == "$STUB" ]]; }
code_mode() {
  local dir n; dir=$(code_dir "$1")
  [[ -d $dir ]] || { echo shared; return; }
  for n in "${SYNCED[@]}"; do if is_ours "$dir" "$n"; then echo synced; return; fi; done
  if is_stub "$dir"; then echo synced; else echo own; fi
}
# Settings that can carry a key or a token (an env block, a credential helper) are never copied.
# Only key names are matched, never values.
has_secrets() { grep -qE '"(env|apiKeyHelper|awsAuthRefresh|awsCredentialExport|otelHeadersHelper)"[[:space:]]*:' "$1"; }

# Fails before `add` changes anything if profile $1 can't move to mode $2 now.
check_code() {
  local now; now=$(code_mode "$1")
  [[ $2 == "$now" || ( $2 != shared && $now != shared ) ]] && return 0
  ! is_running "$1" || fail "Quit Claude $1 first: its Claude Code mode can't change while it runs."
  [[ $2 != shared || ! -e $(code_dir "$1").off ]] || fail "$(code_dir "$1").off already exists: move it aside first."
}

# This profile's Claude Code sessions, from Claude's own list of them. Ids name files, so only UUIDs.
session_ids() {
  local dir; dir="$(data_dir "$1")/claude-code-sessions"
  [[ -d $dir ]] || return 0
  find "$dir" -type f -name 'local_*.json' -exec sed -n 's/.*"cliSessionId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' {} + |
    grep -E '^[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$' | sort -u || true
}
# Copies $1 to $2 unless $2 is there already; an interrupted copy never stays half done.
copy_new() {
  [[ -e $1 && ! -e $2 ]] || return 1
  if ! { mkdir -p "$(dirname "$2")" && rm -rf "$2.partial" && cp -R "$1" "$2.partial" && mv "$2.partial" "$2"; }; then
    fail "Could not copy $1. Run add again to go on."
  fi
}
# Copies profile $1's sessions (transcript, its folder, file history) from ~/.claude into $2, which
# stays untouched. Prints how many transcripts it copied.
copy_sessions() {
  local id file rel count=0
  while read -r id; do
    for file in "$SHARED"/projects/*/"$id.jsonl"; do
      [[ -f $file ]] || continue
      rel=${file#"$SHARED"/}
      if copy_new "$file" "$2/$rel"; then count=$((count + 1)); fi
      copy_new "${file%.jsonl}" "$2/${rel%.jsonl}" || true
    done
    copy_new "$SHARED/file-history/$id" "$2/file-history/$id" || true
  done < <(session_ids "$1")
  echo "$count"
}

# Puts profile $1 on Claude Code mode $2 and says what changed. check_code ran first.
set_code() {
  local name=$1 mode=$2 dir work n count list=""
  dir=$(code_dir "$name")
  if [[ $mode == shared ]]; then
    if [[ -d $dir ]]; then
      mv "$dir" "$dir.off"
      echo "  Claude Code: shares ~/.claude again. Its own folder is kept as $dir.off; --claude-code own brings it back."
    else
      echo "  Claude Code: shares ~/.claude with the regular Claude (--claude-code own gives it its own)."
    fi
    return
  fi
  if [[ ! -d $dir ]]; then
    # Filled aside and renamed last: a copy that stops halfway leaves the profile shared, and add goes on from there.
    if [[ -d $dir.off ]]; then work=$dir.off; else work=$dir.new; fi
    mkdir -p "$work"
    count=$(copy_sessions "$name" "$work")
    mv "$work" "$dir"
    rm -rf "$dir.new"   # only now: a copy an interrupted run left, when the parked folder came back
    if (( count )); then echo "  Copied $count Claude Code session(s) of this profile from ~/.claude, which stays as it is."; fi
  fi
  if [[ $mode == own ]]; then
    for n in "${SYNCED[@]}"; do if is_ours "$dir" "$n"; then rm "${dir:?}/$n"; fi; done   # the link, not ~/.claude
    if is_stub "$dir"; then rm "$dir/CLAUDE.md"; fi
    echo "  Claude Code: its own settings and sessions, in $dir."
    return
  fi
  # synced: what the profile has itself always wins; nothing is ever created in ~/.claude.
  if [[ ! -e $dir/settings.json && -f $SHARED/settings.json ]]; then
    if has_secrets "$SHARED/settings.json"; then
      echo "  ~/.claude/settings.json was not copied: it has an env block or a credential helper. Copy what you need by hand."
    else
      cp "$SHARED/settings.json" "$dir/settings.json"
      echo "  Copied ~/.claude/settings.json once; from now on this profile keeps its own."
    fi
  fi
  for n in "${SYNCED[@]}"; do
    if [[ -d $SHARED/$n && ! -e $dir/$n && ! -L $dir/$n ]]; then ln -s "$SHARED/$n" "$dir/$n"; fi
    if is_ours "$dir" "$n"; then list+="$n, "; fi
  done
  if [[ -f $SHARED/CLAUDE.md && ! -e $dir/CLAUDE.md ]]; then echo "$STUB" > "$dir/CLAUDE.md"; fi
  if is_stub "$dir"; then list+="CLAUDE.md, "; fi
  list=${list%, }
  echo "  Claude Code: its own settings and sessions, in $dir; from ~/.claude: ${list:-nothing to link yet, run add again later}."
}

# An existing profile's spelling, so `open work` or `add work` acts on profile "Work".
canonical() {
  local name
  if [[ -f $(entry_of "$1") ]]; then name=$(entry_key "$(entry_of "$1")" Name); echo "${name#Claude }"; else echo "$1"; fi
}

# Where desktop entries and icons live: the user's folder, then the system ones (Flatpak and Snap
# add their exports to XDG_DATA_DIRS).
data_dirs() {
  local dir; local -a dirs
  IFS=: read -ra dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for dir in "$DATA" "${dirs[@]}"; do [[ -z $dir ]] || echo "$dir"; done
}

# The official desktop entry says how Claude is launched and which icon it uses.
claude_entry() {
  local dir file; local -a dirs
  mapfile -t dirs < <(data_dirs)
  for dir in "${dirs[@]}"; do
    for file in "$dir"/applications/*.desktop; do
      [[ -f $file && $(basename "$file") != multi-claude-* ]] || continue
      if grep -qE '^Name=Claude( Desktop)?$' "$file"; then echo "$file"; return 0; fi
    done
  done
  return 1
}

claude_launch() { entry_key "$1" Exec | sed -E 's/ ?%[fFuUdDnNickvm]//g'; }   # drop field codes

claude_icon() {
  local icon size dir; local -a dirs
  icon=$(entry_key "$1" Icon)
  if [[ $icon == /* && -f $icon ]]; then echo "$icon"; return 0; fi
  mapfile -t dirs < <(data_dirs)
  for size in 512x512 256x256 128x128; do
    for dir in "${dirs[@]}"; do
      if [[ -f $dir/icons/hicolor/$size/apps/$icon.png ]]; then echo "$dir/icons/hicolor/$size/apps/$icon.png"; return 0; fi
    done
  done
  if [[ -f /usr/share/pixmaps/$icon.png ]]; then echo "/usr/share/pixmaps/$icon.png"; return 0; fi
  return 1
}

cmd_add() {
  local name=$1 color=$2 code=${3,,} hex entry icon dir colored part
  check_name "$name"
  case $code in
    own|synced|shared) ;;
    "") if [[ -d $(data_dir "$name") ]]; then code=$(code_mode "$name"); else code=own; fi ;;   # a new profile: own
    *) fail "Unknown Claude Code mode '$3'. Use own, synced or shared." 64 ;;
  esac
  hex=${color#\#}
  [[ -z $color ]] || hex=${PALETTE[${color,,}]:-$hex}   # an empty key is a bash error
  [[ $hex =~ ^[0-9A-Fa-f]{6}$ ]] || fail "Unknown color '$color'. Use $COLORS or a hex value like C0392B." 64
  # --claude-code alone on an existing profile changes only that: nothing records its color.
  if [[ -f $(entry_of "$name") && -n $3 && $color_given == 0 ]]; then check_code "$name" "$code"; set_code "$name" "$code"; return; fi
  entry=$(claude_entry) || fail "$NOT_FOUND"
  icon=$(claude_icon "$entry") || fail "Could not find Claude's icon ($(entry_key "$entry" Icon))."
  command -v python3 >/dev/null || fail "python3 is required to color the icon."
  check_code "$name" "$code"

  # The profile folder appears only once the icon is colored, so a failure leaves nothing behind.
  dir=$PROFILES/$name
  mkdir -p "$PROFILES" "$ENTRIES"
  colored=$(mktemp "$PROFILES/.icon.XXXXXX")
  python3 "$HERE/recolor.py" "$icon" "$colored" "$hex" || { rm -f "$colored"; exit 1; }
  chmod 644 "$colored"
  mkdir -p "$dir" && mv -f "$colored" "$dir/icon.png"
  # Written aside, then moved in, so an interrupted add never leaves a half-written launcher.
  part=$(mktemp "$ENTRIES/.$(app_id "$name").XXXXXX")
  cat > "$part" <<EOF || { rm -f "$part"; exit 1; }
[Desktop Entry]
Type=Application
Name=Claude $name
Comment=Claude Desktop - $name
Exec="$HERE/multi-claude" open $name
Icon=$dir/icon.png
StartupWMClass=$(app_id "$name")
Categories=Office;Utility;
Terminal=false
EOF
  chmod 644 "$part" && mv -f "$part" "$(entry_of "$name")"
  if command -v update-desktop-database >/dev/null; then update-desktop-database "$ENTRIES" 2>/dev/null || true; fi

  echo "
  Claude $name is ready: find it in your app launcher and pin it to your dock.
  To sign in by e-mail, open the link in your browser, do not let it open Claude, and ask for a
  code to type in the profile. With single sign-on, quit every other Claude first,
  including other profiles: the browser hands the login to whichever Claude is open."
  set_code "$name" "$code"
}

cmd_list() {
  local file name found=0
  for file in "$ENTRIES"/multi-claude-*.desktop; do
    [[ -f $file ]] || continue
    found=1; name=$(entry_key "$file" Name); name=${name#Claude }
    printf '%-16s %-8s %-7s %s\n' "$name" "$(if is_running "$name"; then echo running; fi)" "$(code_mode "$name")" "$(data_dir "$name")"
  done
  if (( ! found )); then echo "No profiles yet. Add one with: multi-claude add <name>"; fi
}

cmd_open() {
  local entry var; local -a argv
  check_name "$1"
  [[ -f $(entry_of "$1") ]] || fail "No profile named '$1'."
  entry=$(claude_entry) || fail "$NOT_FOUND"
  # Started from inside a Claude session, we would hand its CLAUDE_*/ANTHROPIC_* variables to Claude.
  for var in $(compgen -e); do
    if [[ $var =~ ^(CLAUDE|ANTHROPIC) ]]; then unset "$var"; fi
  done
  if [[ -d $(code_dir "$1") ]]; then export CLAUDE_CONFIG_DIR; CLAUDE_CONFIG_DIR=$(code_dir "$1"); fi
  # Split Exec like a desktop launcher would, so quoted paths ("/opt/Claude Desktop/claude") survive.
  mapfile -t argv < <(xargs -n1 printf '%s\n' <<<"$(claude_launch "$entry")")
  command -v "${argv[0]}" >/dev/null || fail "Cannot run Claude: ${argv[0]}"
  nohup "${argv[@]}" "--user-data-dir=$(data_dir "$1")" "--class=$(app_id "$1")" >/dev/null 2>&1 &
}

cmd_remove() {
  check_name "$1"
  [[ -f $(entry_of "$1") ]] || fail "No profile named '$1'."
  rm -f "$(entry_of "$1")"
  rm -rf "${PROFILES:?}/$1"
  echo "Removed Claude $1. Remove its icon from the dock if you pinned it."
  echo "Its sign-in data is kept in $(data_dir "$1") - delete that folder to sign out for good."
}

cmd_doctor() {
  local entry
  echo "multi-claude $VERSION (Linux support is experimental)"
  if entry=$(claude_entry); then
    echo "Claude Desktop:   $entry"
    echo "  launch: $(claude_launch "$entry")"
    echo "  icon:   $(claude_icon "$entry" || echo 'not found')"
  else
    echo "Claude Desktop:   not found - https://claude.ai/download"
  fi
  if command -v python3 >/dev/null; then echo "  python3: ok"; else echo "  python3: missing"; fi
  if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then echo "CLAUDE_CONFIG_DIR: $CLAUDE_CONFIG_DIR in this terminal; open drops it: each profile uses its own folder or ~/.claude"; fi
  echo
  cmd_list
}

cmd_uninstall() {
  local link=$HOME/.local/bin/multi-claude
  # Only our own link: a real file there is someone else's install.
  if [[ -L $link && $(readlink "$link") == "$DATA/multi-claude/"* ]]; then rm -f "$link"; fi
  rm -f "$ENTRIES"/multi-claude-*.desktop "$ENTRIES"/.multi-claude-*   # the second: left by an interrupted add
  rm -rf "${DATA:?}/multi-claude"
  echo "multi-claude removed. Sign-in data is kept in $CONFIG/Claude-* - delete those folders to sign out for good."
}

# --- arguments ---------------------------------------------------------------------------------------
cmd="" name="" color=green color_given=0 code="" selftest=0
while (( $# )); do
  case $1 in
    -c|--color)   (( $# >= 2 )) || fail "--color needs a value." 64; color=$2; color_given=1; shift ;;
    --claude-code) (( $# >= 2 )) || fail "--claude-code needs a value." 64; code=$2; shift ;;
    -h|--help)    cmd=help ;;
    -v|--version) cmd=version ;;
    --selftest)   selftest=1 ;;
    -*)           fail "Unknown option '$1'."$'\n\n'"$USAGE" 64 ;;
    *)
      if [[ -z $cmd ]]; then cmd=$1
      elif [[ -z $name ]]; then name=$1
      else fail "Unexpected argument '$1'."$'\n\n'"$USAGE" 64; fi ;;
  esac
  shift
done

case ${cmd,,} in
  add)       check_name "$name"; cmd_add "$(canonical "$name")" "$color" "$code" ;;
  list)      cmd_list ;;
  open)      check_name "$name"; cmd_open "$(canonical "$name")" ;;
  remove)    check_name "$name"; cmd_remove "$(canonical "$name")" ;;
  doctor)    cmd_doctor; if (( selftest )); then echo; echo "Self-test: Windows only (taskbar tagging)."; fi ;;
  uninstall) cmd_uninstall ;;
  version)   echo "multi-claude $VERSION" ;;
  help|"")   echo "$USAGE" ;;
  *)         fail "Unknown command '$cmd'."$'\n\n'"$USAGE" 64 ;;
esac
